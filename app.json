{
  "expo": {
    "name": "CondominioApp",
    "slug": "condominioapp",
    "version": "1.1.1",
    "orientation": "default",
    "icon": "./assets/images/logo.png",
    "scheme": "condominioapp",
    "userInterfaceStyle": "automatic",
    "splash": {
      "image": "./assets/images/logo-one-startup.png",
      "resizeMode": "contain",
      "backgroundColor": "#E6F4FE"
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.onestartuptech.appcondominio",
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#E6F4FE",
        "foregroundImage": "./assets/images/logo.png"
      },
      "usesCleartextTraffic": false,
      "predictiveBackGestureEnabled": false,
      "package": "com.onestartuptech.appcondominio"
    },
    "web": {
      "favicon": "./assets/images/favicon.png"
    },
    "extra": {
      "eas": {
        "projectId": "19c12117-3f58-4d4f-ba8c-ae2524c37481"
      },
      "apiUrl": "https://face.onestartup.com.br/morador",
      "apiTimeout": "10000"
    },
    "owner": "onestartuptech",
    "plugins": [
      "expo-secure-store",
      "expo-font",
      [
        "expo-image-picker",
        {
          "photosPermission": "Permitir acesso à galeria para foto do morador (opcional, máx. 200KB).",
          "cameraPermission": "Permitir acesso à câmera para foto do morador."
        }
      ]
    ],
    "runtimeVersion": "1.1.1",
    "updates": {
      "enabled": false,
      "checkAutomatically": "NEVER",
      "fallbackToCacheTimeout": 0
    }
  }
}
